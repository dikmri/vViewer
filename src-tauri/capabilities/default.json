{
  "$schema": "https://schemas.tauri.app/config/2/capability.json",
  "identifier": "default",
  "description": "Default permissions for vViewer",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "shell:default",
    "shell:allow-open",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
