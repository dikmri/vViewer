{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vViewer",
  "version": "0.2.0",
  "identifier": "io.github.dikmri.vviewer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "vViewer",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEODQ2QTBCMjRDRjJFQkUKUldTK0xzOGtDMnFFcmJUWWw4U2pPdEh3MlFXUVFtWmxBNHh2VUh4RVB3THZnazI5RFBlS2pEMjUK",
      "endpoints": [
        "https://github.com/dikmri/vViewer/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
